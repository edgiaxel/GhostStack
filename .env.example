# Optional overrides
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
# Local MCP bridge token, generated per run (never reuse a real secret)
GHOSTSTACK_BRIDGE_TOKEN=
